[Unit]
Description=Kanata keyboard remapper
Documentation=https://github.com/jtroo/kanata

[Service]
Environment=PATH=/usr/local/bin:/usr/local/sbin:/usr/bin:/bin

Type=simple
ExecStart=/usr/bin/kanata --cfg /etc/kanata/kanata.kbd --cfg /etc/kanata/kanata-g.kbd --port 5829
ExecStopPost=/usr/bin/rm -f %t/kanata-state
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
