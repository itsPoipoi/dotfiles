;; `defsrc` defines the keys that will be intercepted by kanata.

(defsrc
        1    2    3    4    5         6    7    8    9    0  -  =
        q    w    e    r    t  bspc   y    u    i    o    p
 caps   a    s    d    f    g         h    j    k    l    ;
 lsft   z    x    c    v    b  102d   n    m    ,    .    /
                  lalt          spc             ralt
)

